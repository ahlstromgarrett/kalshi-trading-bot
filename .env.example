# Copy this file to .env and fill in your own values. Never commit .env.

# From https://kalshi.com/account/profile -> API Keys
KALSHI_API_KEY_ID=
# Path to the PEM private key file whose matching public key you registered with Kalshi.
# Generate with:
#   openssl genpkey -algorithm ed25519 -out kalshi_private_key.pem
# (or RSA: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out kalshi_private_key.pem)
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem

# demo = paper-safe sandbox, prod = real money. Always start with demo.
KALSHI_ENV=demo

# Strategy: which markets qualify as a "base requirement" trade.
# Trades ANY open binary (yes/no) market -- no category allowlist -- where one
# side is priced at/above MIN_PROBABILITY and it settles within the window below.
MIN_PROBABILITY=0.90
MAX_PROBABILITY=0.99
MAX_HOURS_TO_CLOSE=24
MIN_MINUTES_TO_CLOSE=5

# Risk limits enforced by kalshi_bot/risk.py regardless of what the strategy wants.
# All are fractions of current account equity, so they scale as the balance moves.
POSITION_FRACTION=0.03
MAX_POSITION_FRACTION=0.08
MAX_TOTAL_EXPOSURE_FRACTION=0.60
MAX_DAILY_LOSS_FRACTION=0.15
MAX_OPEN_POSITIONS=25
