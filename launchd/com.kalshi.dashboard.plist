<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.kalshi.dashboard</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/ahlstrom/Kalshi/run_dashboard.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/ahlstrom/Kalshi</string>

    <key>StandardOutPath</key>
    <string>/Users/ahlstrom/Kalshi/logs/launchd_dashboard.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/ahlstrom/Kalshi/logs/launchd_dashboard.log</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>30</integer>
</dict>
</plist>
